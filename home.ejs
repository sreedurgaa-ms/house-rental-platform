<%- include('components/navbar') %>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/home.css">
    <script src="/js/script.js" defer></script>
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,200..900;1,8..60,200..900&display=swap');
        @import url('https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Source+Serif+4:ital,opsz,wght@0,8..60,200..900;1,8..60,200..900&display=swap');
        @import url('https://fonts.googleapis.com/css2?family=Gurajada&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Source+Serif+4:ital,opsz,wght@0,8..60,200..900;1,8..60,200..900&display=swap');
    </style>
</head>

<div class="container_id">
    
    <!-- <h1>Home Page</h1> -->
    <div class="grid-container">
        <% data.forEach(item => { %>
            <div class="grid-item">
                <div class="img-class">
                    <img src="data:image/png;base64,<%= item.image.toString('base64') %>" alt="House Image" class="house-image">
                </div>
                <div class="house-info">
                    <div class="house-name">
                        <h2><%= item.house_name %></h2>
                    </div>
                    <p><i class="fas fa-map-marker-alt"></i><%= item.place %></p>
                    <p><i class="fas fa-rupee-sign"></i><%= item.price %></p>
                    <p><i class="fas fa-phone"></i><%= item.phone %></p>
                    <div class="sub-home-info">
                        <p><%= item.bedrooms %> Bedrooms</p>
                        <p><%= item.rooms %> Total rooms</p>
                        <p><%= item.sqft %> Sq.ft</p>
                    </div>
                    <!-- var id = <%= item.id %> -->
                    <!-- <i class="fas fa-trash"></i> -->
                    <div class="button-class">
                        <button class="fas fa-trash" data-id="<%= item.id %>"></button>
                        <button class="fas fa-edit" data-id="<%= item.id %>"></button>
                    </div>
                    
                </div>
            </div>
        <% }); %>
    </div>
</div>