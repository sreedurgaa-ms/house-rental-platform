<%- include('components/navbar') %>
<!-- <%- include('components/particle') %> -->

<head>
    <link rel="stylesheet" href="/styles/form.css">
</head>

<div class="container_id">
    <h1>Add Item</h1>
    <form action="/add" method="POST" enctype="multipart/form-data">
        <div class="form-group">
            <label for="image">Upload House Image (Front View)</label>
            <input type="file" id="image" name="image" required>
        </div>
        <div class="form-group">
            <label for="house-name">House Name</label>
            <input type="text" id="house_name" name="house_name" required>
        </div>
        <div class="form-group">
            <label for="place">Place</label>
            <input type="text" id="place" name="place" required>
        </div>
        <div class="form-group">
            <label for="sqft">Sq.ft</label>
            <input type="number" id="sqft" name="sqft" required>
        </div>
        <div class="form-group">
            <label for="bedrooms">Bedrooms</label>
            <input type="number" id="bedrooms" name="bedrooms" required>
        </div>
        <div class="form-group">
            <label for="rooms">Total Rooms</label>
            <input type="number" id="rooms" name="rooms" required>
        </div>
        <div class="form-group">
            <label for="price">Price</label>
            <input type="text" id="price" name="price" required>
        </div>
        <div class="form-group">
            <label for="phone">Phone</label>
            <input type="text" id="phone" name="phone" required>
        </div>
        <button type="submit">Submit</button>
    </form>
</div>